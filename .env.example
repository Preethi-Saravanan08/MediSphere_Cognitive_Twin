# MediSphere Application Configuration

# Server Configuration
SERVER_PORT=8080
CONTEXT_PATH=/api

# MongoDB Configuration
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DATABASE=medisphere
MONGODB_USERNAME=admin
MONGODB_PASSWORD=medisphere123
SPRING_DATA_MONGODB_URI=mongodb://admin:medisphere123@localhost:27017/medisphere?authSource=admin

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=medisphere-vitals-consumer
KAFKA_AUTO_OFFSET_RESET=earliest

# FHIR Configuration
FHIR_SERVER_URL=http://localhost:8081/fhir
FHIR_AUTH_ENABLED=true
FHIR_TIMEOUT_MS=30000

# JWT Configuration
JWT_ISSUER_URI=http://localhost:8080
JWT_SECRET=your-secret-key-here
JWT_EXPIRATION_MS=3600000

# HIPAA Configuration
AUDIT_ENABLED=true
AUDIT_LOG_FILE=logs/hipaa-audit.log
AUDIT_RETENTION_DAYS=2555

# Feature Flags
FEATURE_FHIR_INTEGRATION=true
FEATURE_KAFKA_STREAMING=true
FEATURE_CONSENT_MANAGEMENT=true
FEATURE_RBAC_ENABLED=true

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/medisphere.log

# Security
ENCRYPTION_KEY=your-encryption-key
HMAC_SECRET=your-hmac-secret

# Email Configuration (for alerts)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=notifications@medisphere.health
MAIL_PASSWORD=your-app-password
MAIL_FROM=noreply@medisphere.health

# Actuator (Spring Boot Admin)
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics,prometheus

# Application Environment
APP_ENVIRONMENT=development
APP_VERSION=1.0.0

# Docker Only
DOCKER_NETWORK=medisphere-network
